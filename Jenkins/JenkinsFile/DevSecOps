pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Compile & Test') { steps { sh '''if [ -x ./mvnw ]; then ./mvnw -B clean verify; else echo "Add your project build command here."; fi''' } }
    stage('SAST / Quality') { steps { echo 'Configure SonarQube or your approved SAST platform.' } }
    stage('SCA') { steps { echo 'Configure OWASP Dependency-Check or your approved SCA tool.' } }
    stage('Container Build') { steps { echo 'Build an immutable image tagged with BUILD_NUMBER or Git SHA.' } }
    stage('Container Scan') { steps { echo 'Example: trivy image --severity HIGH,CRITICAL --exit-code 1 "$IMAGE"' } }
    stage('Publish') { steps { echo 'Push only after build, test and security gates pass.' } }
    stage('Deploy') { steps { echo 'Configure deployment credentials and target environment outside Git.' } }
    stage('Verify') { steps { echo 'Verify rollout status and application health before declaring success.' } }
  }
  post { always { archiveArtifacts artifacts: '**/*-report.*', allowEmptyArchive: true; deleteDir() } }
}
